# Blue-green deploy configuration for scripts/deploy/blue-green/deploy.sh.
# Copy to /srv/spindle/blue-green.env (mode 0600) or export inline. Every
# value has a default shown on the right; only the three marked REQUIRED
# must be set for a real deploy.

# Where the two slot directories and the `current` symlink live.
SPINDLE_BG_ROOT=/srv/spindle/releases
# SPINDLE_BG_CURRENT_LINK=${SPINDLE_BG_ROOT}/current

# Directory holding the built artifact to ship (e.g. a Next.js standalone
# output or a static export). REQUIRED.
# SPINDLE_BG_SOURCE_DIR=/srv/spindle/build/out

# Identifier recorded in <slot>/.release-id and the logs.
# SPINDLE_BG_RELEASE_ID=$(date -u +%Y%m%d%H%M%S)  # CI should pass the commit SHA

# Optional extra rsync flags, word-split (e.g. "--exclude .cache --exclude *.map").
# SPINDLE_BG_EXTRA_RSYNC_EXCLUDES=

# Health checks. Per-slot URLs are polled BEFORE the switch; the slot must
# already be serving on its own address. The public URL is polled AFTER the
# switch and drives the automatic revert.
# SPINDLE_BG_HEALTH_URL_BLUE=http://127.0.0.1:8081/healthz
# SPINDLE_BG_HEALTH_URL_GREEN=http://127.0.0.1:8082/healthz
# SPINDLE_BG_HEALTH_URL=https://app.spindle.app/healthz   # REQUIRED for real runs

# SPINDLE_BG_HEALTH_TIMEOUT=90
# SPINDLE_BG_HEALTH_INTERVAL=2
# SPINDLE_BG_HEALTH_CURL_TIMEOUT=5

# Hooks run through `bash -c`; keep them idempotent because SWITCH runs
# again during an automatic revert.
#   PRE_SWITCH:   start/prepare the target slot's server.
#   SWITCH:       steer traffic to the new slot.
#   POST_SWITCH:  settle steps after a verified switch.
# SPINDLE_BG_PRE_SWITCH_COMMAND=
# SPINDLE_BG_SWITCH_COMMAND=
# SPINDLE_BG_POST_SWITCH_COMMAND=
