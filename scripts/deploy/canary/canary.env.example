# Canary rollout configuration. Copy to the deploy host (or export in the
# deploy shell), fill in, and keep it out of the repository — it contains no
# secrets, but it does name internal endpoints.
#
#   set -a; . ./canary.env; set +a
#   npx tsx scripts/deploy/canary/deploy.ts
#
# See docs/deploy/canary.md for the full reference.

# Candidate image for this rollout (required by deploy.ts; --image overrides).
SPINDLE_CANARY_IMAGE=ghcr.io/spindle/app:SET_BY_DEPLOY

# Ordered traffic percentages; each stage is observed for STAGE_SECONDS.
SPINDLE_CANARY_WEIGHTS=5,25,50
SPINDLE_CANARY_STAGE_SECONDS=600

# Traffic shifting. The template MUST contain {weight}. Point it at whatever
# the environment uses: a weighted Caddy reverse_proxy reload, a Cloudflare
# Load Balancing pool update, a service-mesh endpoint, etc.
# Example (local weighted upstream on the origin host):
#   SPINDLE_CANARY_ROUTER_CMD='curl -fsS -X POST http://127.0.0.1:9145/upstreams/canary/weight -d weight={weight}'
SPINDLE_CANARY_ROUTER_CMD=

# Deploy / promote / rollback / status hooks. {image} is substituted in
# DEPLOY_CMD. When PROMOTE_CMD/ROLLBACK_CMD are unset the scripts fall back
# to ROUTER_CMD at weight 100 / 0.
SPINDLE_CANARY_DEPLOY_CMD=
SPINDLE_CANARY_PROMOTE_CMD=
SPINDLE_CANARY_ROLLBACK_CMD=
SPINDLE_CANARY_STATUS_CMD=

# Gates. SMOKE_URL must return 2xx. METRICS_URL returns JSON
# {"requests":N,"errorRate":F,"p95LatencyMs":N}; while unset the metric gate
# is skipped unless REQUIRE_METRICS=1.
SPINDLE_CANARY_SMOKE_URL=https://app.spindle.app/api/health
SPINDLE_CANARY_SMOKE_ATTEMPTS=10
SPINDLE_CANARY_SMOKE_INTERVAL_MS=5000
SPINDLE_CANARY_SMOKE_TIMEOUT_MS=10000
SPINDLE_CANARY_METRICS_URL=
SPINDLE_CANARY_REQUIRE_METRICS=0

# Thresholds applied to each stage window.
SPINDLE_CANARY_MAX_ERROR_RATE=0.01
SPINDLE_CANARY_MAX_P95_MS=800
SPINDLE_CANARY_MIN_REQUESTS=100
SPINDLE_CANARY_METRICS_POLL_MS=30000
