{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Spindle API deprecations registry",
  "type": "object",
  "required": ["version", "policy", "deprecations"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "policy": { "type": "string" },
    "deprecations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "route", "methods", "deprecatedAt", "sunset", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "route": { "type": "string", "pattern": "^/api/" },
          "methods": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"]
            },
            "minItems": 1
          },
          "deprecatedAt": { "type": "string", "format": "date" },
          "sunset": { "type": "string", "format": "date" },
          "replacement": { "type": "string", "pattern": "^/api/" },
          "announcement": {
            "type": "string",
            "description": "Path to changelog/docs entry announcing the deprecation"
          },
          "requireHeaders": { "type": "boolean", "default": true },
          "status": { "type": "string", "enum": ["announced", "active", "removed"] },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
