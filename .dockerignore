# Keep local and production secrets out of the image. The runtime receives
# them from the secret store; see docs/decisions/0002-secrets-management.md.
.env
.env.*
!.env.example

# Repository and local-only state
.git
.gitignore
.agents/
.github/
.vscode/
.idea/
node_modules/
.node_modules.original/
.next/
coverage/
dist/
legacy/
test-results/
playwright-report/
blob-report/
*.log
*.tsbuildinfo
