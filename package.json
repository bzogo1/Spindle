{
  "name": "spindle-landing",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "next dev",
    "predev": "npm run docs:build",
    "build": "next build",
    "postbuild": "npm run check:client-bundle",
    "check:client-bundle": "node scripts/check-client-bundle.mjs",
    "prebuild": "npm run docs:build",
    "analyze": "ANALYZE=true npm run build -- --webpack && node scripts/bundle-report.mjs",
    "docs:build": "node scripts/build-docs-content.mjs",
    "env:check": "tsx scripts/validate-env.ts",
    "secrets:check": "tsx scripts/secrets/check.ts",
    "secrets:verify-rotation": "tsx scripts/secrets/verify-rotation.ts",
    "secrets:scan": "node scripts/secrets/scan.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node .test_infra.mjs",
    "test:e2e:auth": "playwright test e2e/auth-recovery.spec.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.4.6",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@sentry/nextjs": "^11.14.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cobe": "^0.6.5",
    "dotenv": "^18.0.10",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.544.0",
    "motion": "^14.14.0",
    "next": "^16.4.6",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "shiki": "^4.6.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.4.6",
    "@next/env": "^16.4.6",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.5.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.14",
    "@types/react-dom": "^19.1.9",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "jsdom": "^31.0.1",
    "playwright": "^1.65.1",
    "prettier": "^3.10.1",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "vitest": "^5.1.1"
  }
}
