# ---------------------------------------------------------------------------
# Required in production
# ---------------------------------------------------------------------------
# Absolute origin used for canonical links, the changelog feed, and sharing
# metadata. Required when NODE_ENV=production; optional in development.
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Optional — server and edge runtimes
# ---------------------------------------------------------------------------
# Pooled Postgres connection string used by the app at runtime. Falls back to
# the local compose database when NODE_ENV is not production.
DATABASE_URL=

# Direct Postgres connection string used by Prisma CLI commands (migrate,
# studio, seed). Falls back to the local compose database outside production.
DIRECT_URL=

# Sentry DSN for server and edge errors. Leave empty to disable Sentry.
SENTRY_DSN=

# Release identifier reported to Sentry by server and edge runtimes. When
# empty, the deploy commit SHA is used (VERCEL_GIT_COMMIT_SHA on Vercel,
# GITHUB_SHA in GitHub Actions), falling back to spindle@1.0.0.
SENTRY_RELEASE=

# Commit SHAs set automatically by Vercel and GitHub Actions. Documented for
# completeness; never set them by hand — the platforms inject them at build
# and runtime.
VERCEL_GIT_COMMIT_SHA=
GITHUB_SHA=

# Set to 1 to enforce the full Content-Security-Policy (the policy that is
# otherwise only sent as Content-Security-Policy-Report-Only) instead of the
# safe subset. Only honored when NODE_ENV=production — the full policy breaks
# Turbopack's dev server, so it must stay unset outside production. Read when
# next.config.ts evaluates headers(), so it must be present at both `next
# build` and `next start`. Leave empty until the report-only policy has been
# clean in production.
CSP_ENFORCE=

# ---------------------------------------------------------------------------
# Production secrets — injected at runtime from the secret store
# ---------------------------------------------------------------------------
# Leave every value in this section empty. The container entrypoint reads them
# from Infisical and injects them into the process; see
# docs/decisions/0002-secrets-management.md and docs/runbooks/secrets-rotation.md.
# `npm run secrets:check` validates that the runtime received every name
# without ever printing a value.
B2_KEY_ID=
B2_APPLICATION_KEY=
# Set the previous pair only while rotating the B2 application key.
B2_KEY_ID_PREVIOUS=
B2_APPLICATION_KEY_PREVIOUS=
B2_BUCKET=
B2_ENDPOINT=

RESEND_API_KEY=

# Mailbox that receives contact-form submissions and the verified Resend sender
# used for contact/newsletter email. Both optional; submissions are logged
# either way when Resend is not configured.
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Symmetric keys must be at least 32 characters. The previous value is accepted
# for verification only, and is removed after the overlap window.
SESSION_SECRET=
SESSION_SECRET_PREVIOUS=
EDGE_HMAC_SECRET=
EDGE_HMAC_SECRET_PREVIOUS=
WORKER_SECRET=
WORKER_SECRET_PREVIOUS=

# ---------------------------------------------------------------------------
# Optional — browser
# ---------------------------------------------------------------------------
# Sentry DSN for browser errors and session replay. Leave empty to disable.
NEXT_PUBLIC_SENTRY_DSN=

# Release identifier reported to Sentry by the browser. Leave empty to use the
# deploy commit SHA resolved at build time (see SENTRY_RELEASE above), which
# falls back to spindle@1.0.0.
NEXT_PUBLIC_SENTRY_RELEASE=

# Fraction of browser performance traces sent to Sentry (0–1). Leave empty to
# use the app default of 0.1.
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=

# Data source for the app API client in src/lib/api. "mock" serves fixture data
# from the mock adapter; "http" calls the real backend. Defaults to "mock".
NEXT_PUBLIC_API_MODE=

# Base URL of the backend API used when NEXT_PUBLIC_API_MODE=http, for example
# https://api.example.com. Leave empty to call same-origin /api routes.
NEXT_PUBLIC_API_URL=

# Set to 1 to enable the mock-authenticated app shell under /app (sidebar,
# dashboard, projects, files, lab, chat, agent, settings). The mock session is a
# browser cookie with no backend; leave empty to disable the routes entirely.
NEXT_PUBLIC_MOCK_AUTH=


# ---------------------------------------------------------------------------
# Authentication (optional)
# ---------------------------------------------------------------------------
# JSON map enabling OAuth authorization-code + PKCE sign-in. Each provider
# needs clientId, authorizeUrl, tokenUrl and (for profile lookup) userinfoUrl;
# clientSecret is optional for public PKCE clients. Example:
#   {"github":{"clientId":"…","clientSecret":"…","authorizeUrl":"https://github.com/login/oauth/authorize","tokenUrl":"https://github.com/login/oauth/access_token","userinfoUrl":"https://api.github.com/user","scopes":["read:user","user:email"]}}
# Leave empty to disable OAuth providers; email/password, magic links, 2FA and
# password reset still work through /api/auth/*.
OAUTH_PROVIDERS_JSON=

# Lifetime of passwordless sign-in ("magic link") tokens, in minutes.
# Optional; defaults to 15 and is clamped to the 1–60 minute range. Values
# that are not positive numbers fall back to the default.
MAGIC_LINK_TTL_MINUTES=

# ---------------------------------------------------------------------------
# Build-only — CI repository secret
# ---------------------------------------------------------------------------
# Uploads source maps through withSentryConfig. Never exposed to the runtime.
SENTRY_AUTH_TOKEN=
