# ---------------------------------------------------------------------------
# Required in production
# ---------------------------------------------------------------------------
# Absolute origin used for canonical links, the changelog feed, and sharing
# metadata. Required when NODE_ENV=production; optional in development.
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Optional — server and edge runtimes
# ---------------------------------------------------------------------------
# Pooled Postgres connection string used by the app at runtime. Falls back to
# the local compose database when NODE_ENV is not production.
DATABASE_URL=

# Direct Postgres connection string used by Prisma CLI commands (migrate,
# studio, seed). Falls back to the local compose database outside production.
DIRECT_URL=

# Sentry DSN for server and edge errors. Leave empty to disable Sentry.
SENTRY_DSN=

# Release identifier reported to Sentry. Defaults to spindle@1.0.0.
SENTRY_RELEASE=

# ---------------------------------------------------------------------------
# Production secrets — injected at runtime from the secret store
# ---------------------------------------------------------------------------
# Leave every value in this section empty. The container entrypoint reads them
# from Infisical and injects them into the process; see
# docs/decisions/0002-secrets-management.md and docs/runbooks/secrets-rotation.md.
# `npm run secrets:check` validates that the runtime received every name
# without ever printing a value.
B2_KEY_ID=
B2_APPLICATION_KEY=
# Set the previous pair only while rotating the B2 application key.
B2_KEY_ID_PREVIOUS=
B2_APPLICATION_KEY_PREVIOUS=
B2_BUCKET=
B2_ENDPOINT=

RESEND_API_KEY=

LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Symmetric keys must be at least 32 characters. The previous value is accepted
# for verification only, and is removed after the overlap window.
SESSION_SECRET=
SESSION_SECRET_PREVIOUS=
EDGE_HMAC_SECRET=
EDGE_HMAC_SECRET_PREVIOUS=
WORKER_SECRET=
WORKER_SECRET_PREVIOUS=

# ---------------------------------------------------------------------------
# Optional — browser
# ---------------------------------------------------------------------------
# Sentry DSN for browser errors and session replay. Leave empty to disable.
NEXT_PUBLIC_SENTRY_DSN=

# Data source for the app API client in src/lib/api. "mock" serves fixture data
# from the mock adapter; "http" calls the real backend. Defaults to "mock".
NEXT_PUBLIC_API_MODE=

# Base URL of the backend API used when NEXT_PUBLIC_API_MODE=http, for example
# https://api.example.com. Leave empty to call same-origin /api routes.
NEXT_PUBLIC_API_URL=

# Set to 1 to enable the mock-authenticated app shell under /app (sidebar,
# dashboard, projects, files, lab, chat, agent, settings). The mock session is a
# browser cookie with no backend; leave empty to disable the routes entirely.
NEXT_PUBLIC_MOCK_AUTH=

# ---------------------------------------------------------------------------
# Build-only — CI repository secret
# ---------------------------------------------------------------------------
# Uploads source maps through withSentryConfig. Never exposed to the runtime.
SENTRY_AUTH_TOKEN=
