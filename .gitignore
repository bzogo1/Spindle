node_modules/
dist/
.DS_Store
*.log

.next/

# Regenerated by `next dev` / `next build` (dev and build use different type paths).
next-env.d.ts

coverage/

# Generated Prisma Client (recreated by `npm install` / `npm run db:generate`).
src/generated/prisma/

.env
.env.*
!.env.example

# Local agent config and credentials (never commit provider tokens)
.agents/

# Build/test artifacts
.turbo/
test-results/
*.tsbuildinfo
.node_modules.original/

# Lab run snapshot artifacts (baselines + run diffs)
.lab-snapshots/

# Ad-hoc benchmark snapshots (baselines under scripts/perf/benchmarks/baselines/ are committed)
scripts/perf/benchmarks/snapshots/*
!scripts/perf/benchmarks/snapshots/.gitkeep
storybook-static/

# Visual regression HTML reports
playwright-report-visual/
playwright-report-storybook/

# Local email template previews (scripts/email-preview.ts)
.email-preview/

# Lighthouse CI local report output
.lighthouseci/

# Scratch screenshots (not for commit)
nym*.png

# Scratch debug/probe scripts (not for commit)
overflow-*.mjs
