# Origin host configuration. Copy to /srv/spindle/host.env on the Hetzner box,
# fill in the values, and chmod 600. It is read by `docker compose --env-file`
# and by systemd; it is never baked into an image or committed.
#
# Production application secrets still come from Infisical at container start
# (docs/decisions/0002-secrets-management.md). The values here are the host's
# identity and bootstrap credentials only.

SPINDLE_STACK_NAME=spindle
SPINDLE_ENV=prod
SPINDLE_ROOT=/srv/spindle

# Images are pinned per deploy by the pipeline; `latest` is not allowed.
SPINDLE_APP_IMAGE=ghcr.io/spindle/app:SET_BY_DEPLOY
SPINDLE_WORKER_IMAGE=ghcr.io/spindle/worker:SET_BY_DEPLOY

# Cloudflare Tunnel. The tunnel UUID and credentials are created in the
# Cloudflare dashboard and stored on the host with mode 0600.
CLOUDFLARE_TUNNEL_ID=
CLOUDFLARE_CONFIG_FILE=/srv/spindle/cloudflared/config.yml
CLOUDFLARE_CREDENTIALS_FILE=/srv/spindle/secrets/cloudflared/credentials.json

# The deploy identity that reads prod:/app and prod:/worker. Keep it out of
# shell history; systemd reads this file instead.
INFISICAL_PROJECT_ID=
INFISICAL_TOKEN=

# Postgres superuser for the data volume. The app's DATABASE_URL in Infisical
# must use the same password and the hostname `postgres`.
POSTGRES_DB=spindle
POSTGRES_USER=spindle
POSTGRES_PASSWORD=
