# Terraform-style example for Cloudflare Rate Limiting rules.
# NOT applied anywhere — reference for whoever owns the Cloudflare zone config.
# Requires the Cloudflare provider >= 4.x with `cloudflare_ruleset` support.
#
#   terraform import cloudflare_ruleset.app_rate_limits zones/<zone_id>/http_ratelimit
#
# Rules execute in list order; put broad per-IP caps first, targeted rules after.

resource "cloudflare_ruleset" "app_rate_limits" {
  zone_id = var.cloudflare_zone_id # e.g. data "cloudflare_zone" "spindle" .id
  name    = "spindle-app-rate-limits"
  kind    = "zone"
  phase   = "http_ratelimit"

  # Health/ready probes are skipped entirely — never rate limit them.
  rules {
    action      = "skip"
    expression  = "(http.request.uri.path in {\"/api/health\" \"/api/ready\" \"/healthz\" \"/readyz\"})"
    description = "bypass healthchecks"
    enabled     = true

    action_parameters {
      phases = ["http_ratelimit"]
    }
  }

  # Tier 1 — per-IP volumetric cap across the whole app hostname.
  rules {
    action      = "block"
    expression  = "(http.host eq \"app.spindle.app\")"
    description = "per-IP global cap: 300 req / 10s"
    enabled     = true

    ratelimit {
      characteristics     = ["ip.src", "cf.colo.id"]
      period              = 10
      requests_per_period = 300
      mitigation_timeout  = 10
    }
  }

  # Tier 2 — auth surfaces: tighter cap on credential guessing.
  rules {
    action      = "block"
    expression  = "(http.host eq \"app.spindle.app\") and (starts_with(http.request.uri.path, \"/api/auth/\"))"
    description = "auth endpoints: 30 req / 60s per IP"
    enabled     = true

    ratelimit {
      characteristics     = ["ip.src"]
      period              = 60
      requests_per_period = 30
      mitigation_timeout  = 60
    }
  }

  # Tier 3 — public forms: challenge rather than hard block (CGNAT collateral).
  rules {
    action      = "managed_challenge"
    expression  = "(http.host eq \"app.spindle.app\") and (http.request.uri.path in {\"/api/contact\" \"/api/newsletter\"})"
    description = "public forms: 5 req / 600s per IP"
    enabled     = true

    ratelimit {
      characteristics     = ["ip.src"]
      period              = 600
      requests_per_period = 5
      mitigation_timeout  = 600
    }
  }

  # Tier 4 — placeholder per-API-key bucket once keys are issued.
  rules {
    action      = "block"
    expression  = "(http.host eq \"app.spindle.app\") and (http.request.headers[\"x-api-key\"] ne \"\")"
    description = "per-API-key placeholder: 600 req / 60s"
    enabled     = true

    ratelimit {
      characteristics     = ["http.request.headers[\"x-api-key\"]"]
      period              = 60
      requests_per_period = 600
      mitigation_timeout  = 60
    }
  }

  # Lab hostname: cap WebSocket upgrade churn, not session traffic.
  rules {
    action      = "block"
    expression  = "(http.host eq \"lab.spindle.app\") and (http.request.uri.path eq \"/\")"
    description = "lab WS upgrades: 120 req / 60s per IP"
    enabled     = true

    ratelimit {
      characteristics     = ["ip.src"]
      period              = 60
      requests_per_period = 120
      mitigation_timeout  = 60
    }
  }
}
