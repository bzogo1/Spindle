# nginx.conf.example — REFERENCE ONLY.
#
# Equivalent gateway reference to Caddyfile.example. Same caveat: a dedicated
# gateway is not part of the deployed topology; see
# docs/architecture/api-gateway.md. If adopted, cloudflared → nginx (:8081)
# → app:8080, plaintext on the internal network.
#
# Tuned for: SSE streams, WebSocket upgrades (defensive — lab traffic uses a
# separate hostname and should stay off this proxy), and pass-through of the
# app's own security headers.

worker_processes auto;
events { worker_connections 1024; }

http {
	# WebSocket upgrade support (harmless for SSE-only traffic).
	map $http_upgrade $connection_upgrade {
		default upgrade;
		''      close;
	}

	# SSE: no buffering, long read timeouts for agent runs / /api streams.
	proxy_buffering off;
	proxy_request_buffering off;
	proxy_read_timeout 3600s;
	proxy_send_timeout 3600s;

	# Real client IP comes from Cloudflare; trust only the tunnel hop.
	# cloudflared appends to X-Forwarded-For; the last hop is the connector.
	set_real_ip_from 172.16.0.0/12;   # docker networks; tighten to the tunnel subnet
	real_ip_header X-Forwarded-For;
	real_ip_recursive on;

	server {
		listen 8081;
		server_name app.spindle.app;

		location / {
			proxy_pass http://app:8080;
			proxy_http_version 1.1;
			proxy_set_header Host $host;
			proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
			proxy_set_header X-Forwarded-Proto https; # edge is always HTTPS
			proxy_set_header X-Real-IP $remote_addr;
			# WebSocket upgrade headers — harmless for SSE, required if any
			# same-hostname WS endpoint ever lands on the app.
			proxy_set_header Upgrade $http_upgrade;
			proxy_set_header Connection $connection_upgrade;

			# SSE must not be buffered by nginx.
			proxy_buffering off;
			proxy_cache off;
			chunked_transfer_encoding on;
		}

		# ── Optional: coarse rate limit on token-bearing auth routes ──────
		# Cloudflare Pro already offers dashboard rate-limiting rules keyed
		# on IP; prefer those. This is the origin-side fallback.
		#
		# limit_req_zone $binary_remote_addr zone=auth:10m rate=20r/m;
		#
		# location ~ ^/api/auth/(signin|password|passwordless|2fa) {
		#     limit_req zone=auth burst=10 nodelay;
		#     limit_req_status 429;
		#     proxy_pass http://app:8080;
			#     ...same proxy_set_header block as above...
		# }
	}
}
