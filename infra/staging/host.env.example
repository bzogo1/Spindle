# Staging host configuration. This instance is separate from production: its
# own tunnel, Postgres volume, B2 bucket, and Infisical `staging` environment.
# Copy to /srv/spindle-staging/host.env, fill in, and chmod 600.

SPINDLE_STACK_NAME=spindle-staging
SPINDLE_ENV=staging
SPINDLE_ROOT=/srv/spindle-staging

# Built from the same commit as production; tags are immutable.
SPINDLE_APP_IMAGE=ghcr.io/spindle/app:SET_BY_DEPLOY
SPINDLE_WORKER_IMAGE=ghcr.io/spindle/worker:SET_BY_DEPLOY

CLOUDFLARE_TUNNEL_ID=
CLOUDFLARE_CONFIG_FILE=/srv/spindle-staging/cloudflared/config.yml
CLOUDFLARE_CREDENTIALS_FILE=/srv/spindle-staging/secrets/cloudflared/credentials.json

# The deploy identity reads staging:/app and staging:/worker.
INFISICAL_PROJECT_ID=
INFISICAL_TOKEN=

# Staging database, isolated from production.
POSTGRES_DB=spindle
POSTGRES_USER=spindle
POSTGRES_PASSWORD=
